{
  "name": "grokbotagent-cli",
  "version": "0.5.1",
  "description": "Standalone CLI for orchestrating a GrokBot AI workforce from any terminal or agent runtime (Claude Code, Hermes, Codex).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "bin": {
    "grokbot": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/fixtures",
    "!dist/skill-commands.*",
    "skills/"
  ],
  "dependencies": {
    "grokbot-core": "^0.5.1",
    "uqr": "0.1.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuncio-hq/grokbot-cli.git",
    "directory": "packages/grokbot-cli"
  },
  "keywords": [
    "grokbot",
    "grokbot-cli",
    "cli",
    "agents"
  ],
  "scripts": {
    "build": "tsc -b && chmod +x dist/cli.js"
  }
}
